[Unit]
Description=LANN Bot to Site candidate handoff
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=app_lann_site
Group=app_lann_site
WorkingDirectory=/srv/apps/lann-site/repo
EnvironmentFile=/srv/apps/lann-site/repo/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/apps/lann-site/repo/.venv/bin/python -m scripts.process_remote_site_handoff
TimeoutStartSec=10min
Nice=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/apps/lann-site/repo/data

[Install]
WantedBy=multi-user.target

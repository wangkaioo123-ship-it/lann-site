{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "site-dashboard-analysis-export/v0.1",
  "title": "LANN Site to Dashboard analysis export manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "published_at",
    "source_run",
    "layout",
    "files",
    "summary",
    "latest_success_sha256",
    "dashboard_write_allowed"
  ],
  "properties": {
    "schema_version": { "const": "site-dashboard-analysis-export/v0.1" },
    "published_at": { "type": "string", "format": "date-time" },
    "source_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_month", "run_id", "run_schema_version"],
      "properties": {
        "run_month": { "type": "string", "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$" },
        "run_id": { "type": "string", "pattern": "^[0-9a-f]{8,64}$" },
        "run_schema_version": { "const": "franchise-operating-run/v0.1" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_root", "latest_success", "run_path", "required_run_files"],
      "properties": {
        "review_root": { "const": "franchise_operating_reviews" },
        "latest_success": { "const": "franchise_operating_reviews/latest_success.json" },
        "run_path": { "type": "string" },
        "required_run_files": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": ["analysis_catalog.json", "business_review.json", "manifest.json", "review.json"]
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "summary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "path", "sha256", "bytes"],
          "properties": {
            "status": { "const": "published" },
            "path": { "const": "site_performance_summary_bi_feishu_rent.csv" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "bytes": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": { "const": "not_published" },
            "reason": { "const": "source_missing" }
          }
        }
      ]
    },
    "latest_success_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "dashboard_write_allowed": { "const": false }
  }
}

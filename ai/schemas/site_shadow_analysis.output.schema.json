{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "site_shadow_analysis output v0.1",
  "type": "object",
  "required": [
    "schema_version",
    "analysis_id",
    "analysis_as_of",
    "analysis_status",
    "candidate",
    "intake_control",
    "source_registry",
    "source_summary",
    "evidence_facts",
    "owner_judgments",
    "current_stage",
    "risk_assessments",
    "matching_summary",
    "customer_matches",
    "missing_information",
    "next_actions",
    "human_confirmation_required",
    "writeback_allowed"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "analysis_id": {
      "type": "string"
    },
    "analysis_as_of": {
      "type": "string",
      "format": "date"
    },
    "analysis_status": {
      "type": "string",
      "enum": [
        "待资料解析",
        "结构化影子分析待人工确认"
      ]
    },
    "candidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "candidate_name",
        "city"
      ],
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "candidate_name": {
          "type": "string"
        },
        "city": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "intake_control": {
      "type": "object",
      "required": [
        "upstream_schema",
        "project_status",
        "source_channel",
        "requested_action",
        "input_summary_confirmed",
        "confirmed_at",
        "external_writes"
      ]
    },
    "source_registry": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "source_type",
          "title",
          "ref",
          "availability"
        ]
      }
    },
    "source_summary": {
      "type": "object",
      "required": [
        "可读取",
        "缺失",
        "不可读取"
      ],
      "properties": {
        "可读取": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "缺失": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "不可读取": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "evidence_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fact_id",
          "category",
          "field",
          "value",
          "fact_kind",
          "source_refs",
          "confidence"
        ]
      }
    },
    "owner_judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "judgment_id",
          "owner",
          "judgment_type",
          "statement",
          "source_refs"
        ]
      }
    },
    "current_stage": {
      "type": "object",
      "properties": {
        "workflow_stage": {
          "type": "string",
          "enum": [
            "待研判",
            "招商接洽",
            "条件核验",
            "可推荐",
            "租赁合约推进",
            "已签约",
            "已开业",
            "暂缓关闭"
          ]
        }
      },
      "required": [
        "workflow_stage",
        "rent",
        "engineering_precheck",
        "operating_feasibility_visit",
        "engineer_site_survey",
        "contract_engineering_confirmation",
        "source_refs",
        "summary",
        "engineering_boundary"
      ]
    },
    "risk_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "risk_id",
          "risk_type",
          "level",
          "statement",
          "owner",
          "source_refs",
          "qualification"
        ]
      }
    },
    "matching_summary": {
      "type": "object",
      "required": [
        "recommended_count",
        "site_declined_count",
        "considering_count",
        "matched_count",
        "overdue_pending_count",
        "separation_note"
      ]
    },
    "customer_matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "customer_id",
          "customer_state",
          "site_match_state",
          "recommended_at",
          "urgency",
          "source_refs",
          "decision_days",
          "decision_deadline",
          "decision_status"
        ]
      }
    },
    "missing_information": {
      "type": "array"
    },
    "next_actions": {
      "type": "array"
    },
    "human_confirmation_required": {
      "const": true
    },
    "writeback_allowed": {
      "const": false
    }
  },
  "additionalProperties": false
}

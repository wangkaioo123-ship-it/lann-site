# 飞书应用凭据（复制本文件为 .env 后填入真实值，.env 不会进 git，切勿提交/push）
# 服务器部署须用【专用企业自建应用】，只授予 多维表格只读(bitable:app:readonly)，
# 且只把"租赁信息表/加盟商意见表"两个 Base 加为只读协作者——不复用 lann-bot/lann-dashboard 的生产 app。
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# 租赁信息表的定位（从多维表格浏览器地址栏获取）
# 地址形如 feishu.cn/base/<app_token>?table=<table_id>
LEASE_TABLE_APP_TOKEN=
LEASE_TABLE_ID=

# 扩展管理/开发项目表定位（从多维表格浏览器地址栏获取）
EXPANSION_TABLE_APP_TOKEN=
EXPANSION_TABLE_ID=
EXPANSION_TABLE_VIEW_ID=

# 可选：如果本机访问飞书 API 需要走代理（Clash 默认 7890），填入；不需要则留空
FEISHU_HTTP_PROXY=

# BI API readonly access. Fill these in .env only; never commit real values.
BI_API_BASE_URL=http://example.local:3001
BI_API_KEY=
# Metabase API keys usually use X-API-Key with the raw key value.
BI_API_KEY_HEADER=X-API-Key
BI_API_AUTH_SCHEME=Raw
# Optional test paths supplied by IT. Start with "/" if no docs are available.
BI_API_TEST_PATH=/
BI_API_REVENUE_PATH=
BI_API_USERNAME=
BI_API_PASSWORD=

# Bot -> Site -> Dashboard 自动交接。Site 只持有处理专用凭证。
SITE_HANDOFF_BASE_URL=https://management.lannlife.com/site-selection/api
SITE_HANDOFF_PROCESSOR_TOKEN=
SITE_HANDOFF_TIMEOUT_SECONDS=90
# 只有服务器安装了 requirements-ocr.txt 后才启用。
SITE_HANDOFF_ENABLE_OCR=false
SITE_HANDOFF_OUTPUT_DIR=/srv/apps/lann-site/repo/data/staging/remote-handoff

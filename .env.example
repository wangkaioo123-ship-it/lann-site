# 飞书应用凭据（复制本文件为 .env 后填入真实值，.env 不会进 git，切勿提交/push）
# 服务器部署须用【专用企业自建应用】，只授予 多维表格只读(bitable:app:readonly)，
# 且只把"租赁信息表/加盟商意见表"两个 Base 加为只读协作者——不复用 lann-bot/lann-dashboard 的生产 app。
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# 租赁信息表的定位（从多维表格浏览器地址栏获取）
# 地址形如 feishu.cn/base/<app_token>?table=<table_id>
LEASE_TABLE_APP_TOKEN=
LEASE_TABLE_ID=

# 可选：如果本机访问飞书 API 需要走代理（Clash 默认 7890），填入；不需要则留空
FEISHU_HTTP_PROXY=
